# The server is loopback-only by default. Keep this unless you have configured
# an ingest token and understand the network exposure.
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=5000

# Optional shared secret used by local bridge processes. Required when binding
# the server to a non-loopback address.
ORCHESTRATOR_INGEST_TOKEN=

REQUEST_DEBOUNCE_SECONDS=8
MAX_QUEUE_ITEMS=50
MAX_REQUEST_CHARS=180

# Optional TikFinity local WebSocket bridge settings.
TIKFINITY_WS_URL=ws://127.0.0.1:21213/
ORCHESTRATOR_INGEST_URL=http://127.0.0.1:5000/ingest
BRIDGE_RECONNECT_SECONDS=3
